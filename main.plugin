#!name = Fanka v1.2
#!desc = 取关未回关的用户；访问http://finka-unfollow.loon.invalid/
#!author = fafatop
#!homepage = https://github.com/fafatop/fanka-unfollow
#!icon = https://raw.githubusercontent.com/fafatop/fanka-unfollow/refs/heads/main/icon.png
#!loon_version = 3.5.1(983)
#!date = 2026-11-16

[Script]
response if ${url} ~= /^https:\/\/api\.finka\.cn\/vas\/relation\/liked\/(?:unmatched|ban)(?:\?[^#]*)?$/ then script("https://raw.githubusercontent.com/fafatop/fanka-unfollow/5834e979d425502d992148bd11d8e329e0b836f1/scripts/collect.js") with requires_body=true, timeout=10, tag="Capture unfollow lists"
request if ${url} ~= /^http:\/\/finka-unfollow\.loon\.invalid\/(?:[^#]*)?$/ then script("https://raw.githubusercontent.com/fafatop/fanka-unfollow/5834e979d425502d992148bd11d8e329e0b836f1/scripts/control.js") with timeout=300, tag="Fanka unfollow manager"

[Host]
finka-unfollow.loon.invalid = 192.0.2.9

[Mitm]
hostname = api.finka.cn

